{
  "name": "genuineedu-web",
  "version": "2.0.0",
  "description": "单词拼写测试网页版",
  "main": "index.html",
  "scripts": {
    "dev": "python -m http.server 8080",
    "build": "node tools/build.mjs",
    "test": "node --test tests/core.test.js tests/jev-client.test.js && node tools/build.mjs --check",
    "test:agent": "node tests/agent.test.mjs windows .testcache/win-inst",
    "test:install": "node tests/install-windows.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "dist": "node tools/build.mjs --dist"
  },
  "keywords": [
    "vocabulary",
    "test",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "puppeteer-core": "23.11.1"
  }
}
